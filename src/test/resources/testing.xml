<suite name="CucumberParallelSuite" parallel="tests" thread-count="2">
    <test name="Run AddEmployer">
        <parameter name="cucumber.tags" value="@AddEmployer"/>
        <classes>
            <class name="cucumberTestNGRunner"/>
        </classes>
    </test>
